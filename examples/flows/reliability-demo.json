[
  {
    "id": "tab-reliability-demo",
    "type": "tab",
    "label": "Metadata reliability demo",
    "disabled": false,
    "info": "Normal, retry, timeout, malformed-response, validation, and MQTT-routing examples."
  },
  {
    "id": "metadata-service-demo",
    "type": "metadata-service",
    "name": "Local mock service",
    "baseUrl": "http://127.0.0.1:4010",
    "timeoutMs": "500",
    "maxResponseBytes": "16384",
    "retryCount": "1",
    "retryDelayMs": "100",
    "maxConcurrent": "2",
    "maxQueueDepth": "8"
  },
  {
    "id": "lookup-demo",
    "type": "resilient-metadata",
    "z": "tab-reliability-demo",
    "name": "Bounded metadata lookup",
    "service": "metadata-service-demo",
    "requestProperty": "payload",
    "x": 520,
    "y": 180,
    "wires": [["success-debug", "mqtt-shape"], ["error-debug"]]
  },
  {
    "id": "normal-inject",
    "type": "inject",
    "z": "tab-reliability-demo",
    "name": "Normal response",
    "props": [{ "p": "payload" }],
    "payload": "{\"productId\":\"drive-200\",\"version\":\"2.4.1\",\"locale\":\"en-US\"}",
    "payloadType": "json",
    "x": 180,
    "y": 80,
    "wires": [["lookup-demo"]]
  },
  {
    "id": "retry-inject",
    "type": "inject",
    "z": "tab-reliability-demo",
    "name": "Transient retry",
    "props": [{ "p": "payload" }],
    "payload": "{\"productId\":\"retry-demo\"}",
    "payloadType": "json",
    "x": 180,
    "y": 130,
    "wires": [["lookup-demo"]]
  },
  {
    "id": "timeout-inject",
    "type": "inject",
    "z": "tab-reliability-demo",
    "name": "Bounded timeout",
    "props": [{ "p": "payload" }],
    "payload": "{\"productId\":\"timeout-demo\"}",
    "payloadType": "json",
    "x": 180,
    "y": 180,
    "wires": [["lookup-demo"]]
  },
  {
    "id": "malformed-inject",
    "type": "inject",
    "z": "tab-reliability-demo",
    "name": "Malformed response",
    "props": [{ "p": "payload" }],
    "payload": "{\"productId\":\"malformed-demo\"}",
    "payloadType": "json",
    "x": 180,
    "y": 230,
    "wires": [["lookup-demo"]]
  },
  {
    "id": "invalid-inject",
    "type": "inject",
    "z": "tab-reliability-demo",
    "name": "Invalid input",
    "props": [{ "p": "payload" }],
    "payload": "{\"productId\":\"\"}",
    "payloadType": "json",
    "x": 170,
    "y": 280,
    "wires": [["lookup-demo"]]
  },
  {
    "id": "success-debug",
    "type": "debug",
    "z": "tab-reliability-demo",
    "name": "Validated metadata",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 790,
    "y": 130,
    "wires": []
  },
  {
    "id": "error-debug",
    "type": "debug",
    "z": "tab-reliability-demo",
    "name": "Structured error",
    "active": true,
    "tosidebar": true,
    "complete": "metadataError",
    "targetType": "msg",
    "x": 780,
    "y": 230,
    "wires": []
  },
  {
    "id": "mqtt-shape",
    "type": "change",
    "z": "tab-reliability-demo",
    "name": "Set MQTT topic",
    "rules": [{ "t": "set", "p": "topic", "pt": "msg", "to": "portfolio/metadata", "tot": "str" }],
    "x": 770,
    "y": 180,
    "wires": [["mqtt-output"]]
  },
  {
    "id": "mqtt-output",
    "type": "mqtt out",
    "z": "tab-reliability-demo",
    "name": "Optional local MQTT output",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "mqtt-local",
    "x": 1020,
    "y": 180,
    "wires": []
  },
  {
    "id": "mqtt-local",
    "type": "mqtt-broker",
    "name": "Local broker",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "",
    "autoConnect": false,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {}
  }
]
