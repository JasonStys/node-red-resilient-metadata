{
  "name": "node-red-contrib-resilient-metadata",
  "version": "1.0.0",
  "description": "Credential-safe Node-RED metadata lookup with bounded concurrency, cancellation, structured errors, and tested message contracts.",
  "keywords": [
    "node-red",
    "metadata",
    "industrial-iot",
    "integration",
    "bounded-queue",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jason Stys",
  "type": "commonjs",
  "files": [
    "dist/",
    "docs/message-contract.md",
    "examples/flows/",
    "schemas/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "metadata-service": "dist/nodes/metadata-service.js",
      "resilient-metadata": "dist/nodes/resilient-metadata.js"
    }
  },
  "scripts": {
    "benchmark": "tsx src/benchmark.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-editor.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "pack:artifact": "pnpm build && pnpm pack --pack-destination artifacts",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm benchmark && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@types/node-red": "1.3.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "node-red": "5.0.7",
    "node-red-node-test-helper": "0.3.6",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
